{
  "name": "formula-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node --watch server/index.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "start": "node server/index.js",
    "setup": "node prisma/init.js && prisma generate && prisma db push && node prisma/seed.js",
    "test": "node --test server/formula.test.js",
    "test:integration": "node server/integration.test.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "dotenv": "16.6.1",
    "express": "4.21.2",
    "nodemailer": "7.0.10",
    "prisma": "6.19.0",
    "qrcode": "1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "prettier": "^3.6.2",
    "vite": "6.3.6"
  }
}
